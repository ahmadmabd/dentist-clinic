generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Patient {
  id         Int         @id @default(autoincrement())
  firstName  String
  lastName   String
  phone      String
  totalPrice Decimal
  address    String

  treatments Treatment[]
  payments   Payment[]
}

model Treatment {
  id        Int     @id @default(autoincrement())
  name      String
  before    String
  after     String
  patientId Int

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model Payment {
  id        Int      @id @default(autoincrement())
  amount    Decimal
  createdAt DateTime @default(now())

  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}